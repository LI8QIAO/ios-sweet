diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -620,6 +620,33 @@
 			    touch_rd(st.gpio, 0x22000), touch_rd(st.gpio, 0x63000),
 			    touch_rd(st.gpio, 0x7d000));
 		}
+		if (probe) {
+			/* polaris pins. The v16b screen photo shows 33/34 at function 1
+			 * (qup11) while this bus is se14, and 99 at function 1 (a debug
+			 * output, most likely holding the controller in reset). The mux is
+			 * a boot-arg so both wirings can be tried without a rebuild:
+			 *   sweetpinmux=2  qup14 (what i2c@a98000 implies)
+			 *   sweetpinmux=1  qup11 (what ABL left behind)
+			 *   sweetpinmux=0  plain GPIO, bus disconnected
+			 *   absent         leave the pins exactly as ABL left them */
+			int mux = -1;
+			(void)PE_parse_boot_argn("sweetpinmux", &mux, sizeof(mux));
+			touch_gpio(23, 0, 0, 0, true, true);    /* tp_vddio enable */
+			touch_wait(10);
+			touch_gpio(99, 0, 3, 3, true, false);   /* reset asserted */
+			touch_wait(10);
+			touch_gpio(99, 0, 3, 3, true, true);    /* release reset */
+			touch_wait(100);
+			if (mux >= 0) {
+				touch_gpio(33, (unsigned)mux, 0, 0, false, false);
+				touch_gpio(34, (unsigned)mux, 0, 0, false, false);
+			}
+			touch_gpio(125, 0, 3, 3, false, false); /* irq, input, pull-up */
+			printf("SWEET TOUCH PINS mux=%d 23=%#x 33=%#x 34=%#x 99=%#x 125=%#x\n",
+			    mux, touch_rd(st.gpio, TOUCH_GPIO_CFG(23)),
+			    touch_rd(st.gpio, TOUCH_GPIO_CFG(33)), touch_rd(st.gpio, TOUCH_GPIO_CFG(34)),
+			    touch_rd(st.gpio, TOUCH_GPIO_CFG(99)), touch_rd(st.gpio, TOUCH_GPIO_CFG(125)));
+		}
 		/* Only touch the sequencer when the SE already speaks I2C: the
 		 * polaris bus (0xa98000) is the one ABL configured for touch. */
 		if (probe && proto == 3u && !(touch_rd(st.se, SE_STATUS) & 0x1001u)) {
@@ -635,6 +662,18 @@
 				int e38 = touch_read(0x38, 0xa3, false, ft, 1);
 				printf("SWEET TOUCH PROBE 0x38 (focaltech id) err=%d "
 				    "id=%02x irq=%#x\n", e38, ft[0], st.irq_status);
+				/* Keep the result on the panel: the persistent log thread
+				 * deadlocks against the mount I/O this early, so the screen
+				 * is the only channel that survives. */
+				for (unsigned r = 0; r < 300; ++r) {
+					printf("SWEETTOUCH syn=%d ft=%d ftid=%02x sextat=%#x irq=%#x 
+					    "g33=%#x g34=%#x g99=%#x\n",
+					    e20, e38, ft[0], touch_rd(st.se, SE_STATUS), st.irq_status,
+					    touch_rd(st.gpio, TOUCH_GPIO_CFG(33)),
+					    touch_rd(st.gpio, TOUCH_GPIO_CFG(34)),
+					    touch_rd(st.gpio, TOUCH_GPIO_CFG(99)));
+					touch_wait(300);
+				}
 			} else {
 				printf("SWEET TOUCH PROBE: SE init failed, no probe\n");
 			}

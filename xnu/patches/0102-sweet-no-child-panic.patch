diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1666,6 +1666,25 @@
 static bool
 proc_should_trigger_panic(proc_t p, int rv)
 {
+#if DEVELOPMENT || DEBUG
+	/*
+	 * SWEET bring-up: when a launchd child boot task fails, XNU panics so the
+	 * failure is loud. That makes each boot reveal exactly one problem. With
+	 * this boot-arg a failing non-init process is only logged and the boot
+	 * continues, so one boot shows every failing boot task.
+	 */
+	if (p != initproc) {
+		int sweet_no_child_panic = 0;
+		PE_parse_boot_argn("sweet_no_child_panic", &sweet_no_child_panic,
+		    sizeof(sweet_no_child_panic));
+		if (sweet_no_child_panic) {
+			printf("SWEET: %s[%d] exited %d -- not panicking "
+			    "(sweet_no_child_panic)\n", p->p_name,
+			    proc_getpid(p), WEXITSTATUS(rv));
+			return false;
+		}
+	}
+#endif /* DEVELOPMENT || DEBUG */
 	if (p == initproc || (p->p_crash_behavior & POSIX_SPAWN_PANIC_ON_EXIT) != 0) {
 		/* Always panic for launchd or equivalents */
 		return true;

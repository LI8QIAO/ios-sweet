diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -835,6 +835,30 @@
 void sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode);
 static void sweet_crash_strings(const char *name);
 
+/*
+ * SWEET: comma separated process-name match, the same shape as
+ * sweetsample / sweetscan.
+ */
+static bool
+sweet_name_in_list(const char *list, const char *name)
+{
+	size_t n = strlen(name);
+
+	for (const char *t = list; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+
+		if (n > 0 && tl == n && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (end == NULL) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
 void
 sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode)
 {
@@ -894,6 +918,37 @@
 	}
 	if (sig == 6 || sig == 5) {
 		sweet_crash_strings(name);
+	}
+
+	/*
+	 * SWEET bring-up: the console scrolls faster than a photo can keep up
+	 * with, so optionally stop the machine with this crash report as the
+	 * last thing on screen. boot-arg sweet_freeze_on_crash=1, optionally
+	 * narrowed with sweet_freeze_names=a,b. Power cycle to reboot.
+	 */
+	{
+		int sweet_freeze = 0;
+
+		if (PE_parse_boot_argn("sweet_freeze_on_crash", &sweet_freeze,
+		    sizeof(sweet_freeze)) && sweet_freeze != 0) {
+			char sweet_freeze_names[128];
+			bool wanted = true;
+
+			if (PE_parse_boot_argn("sweet_freeze_names",
+			    sweet_freeze_names, sizeof(sweet_freeze_names))) {
+				wanted = sweet_name_in_list(sweet_freeze_names, name);
+			}
+			if (wanted) {
+				volatile int sweet_spin = 0;
+
+				printf("SWEET: frozen on %s crash above "
+				    "(sweet_freeze_on_crash) -- power cycle to reboot\n",
+				    name);
+				for (;;) {
+					sweet_spin = sweet_spin + 1;
+				}
+			}
+		}
 	}
 }
 
